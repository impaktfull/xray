---
import Demo from '../../demo/Demo';
---

<!-- =====================
   Hero Section
   ===================== -->
<section class="hero-section" aria-labelledby="hero-title">
  <!-- Eyebrow -->
  <span class="eyebrow">Built for Flutter developers</span>

  <!-- Title -->
  <h1 class="hero-title" id="hero-title">
    See inside your app.<br />Like never before<span class="accent">.</span>
  </h1>

  <!-- Subtitle -->
  <p class="hero-subtitle">
    xRay gives you real-time visibility into network calls, logs, and
    storage, across iOS, Android, and macOS. Debug faster, ship with
    confidence.
  </p>

  <!-- Buttons -->
  <div class="hero-buttons">
    <a href="#download" class="btn-primary btn-lg">
      <span class="icon" aria-hidden="true">
        <!-- Download icon -->
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
      </span>
      Download App
    </a>
    <a href="#docs" class="btn-outline btn-lg">
      <span class="icon" aria-hidden="true">
        <!-- Book-open icon -->
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
        </svg>
      </span>
      Read the Docs
    </a>
  </div>

  <!-- Interactive demo -->
  <div class="hero-preview hero-demo" id="demo">
    <Demo client:visible />
  </div>

  <script>
    // #demo/<step> links: bring the demo into view, which also loads it; the demo then starts that tour step.
    const revealDemo = () => {
      if (location.hash.startsWith('#demo/')) document.getElementById('demo')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };
    revealDemo();
    window.addEventListener('hashchange', revealDemo);
  </script>
</section>
