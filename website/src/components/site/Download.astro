<!-- =====================
   Download Section
   ===================== -->
<section
  class="section download-section"
  id="download"
  aria-labelledby="download-title"
>
  <div class="section-header">
    <span class="eyebrow">Download</span>
    <h2 class="section-title" id="download-title">
      Soon on every<br />platform<span style="color: var(--accent-light);">.</span>
    </h2>
    <p class="section-subtitle">
      Run the companion app on your development machine or device.
    </p>
  </div>

  <div class="download-grid" role="list">
    <!-- macOS -->
    <article class="download-card" role="listitem">
      <div class="dl-icon-wrap accent" aria-hidden="true">
        <!-- Monitor icon -->
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
          <line x1="8" y1="21" x2="16" y2="21" />
          <line x1="12" y1="17" x2="12" y2="21" />
        </svg>
      </div>
      <h3>macOS</h3>
      <p class="req">macOS 10.15+ required</p>
      <p class="req">Alpha Version available</p>
      <a href="https://docs.page/impaktfull/xray/app/install-macos" class="btn-primary" target="_blank" rel="noopener noreferrer">
        <span class="icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </span>
        Download
      </a>
    </article>

    <!-- Windows -->
    <article class="download-card" role="listitem">
      <div class="dl-icon-wrap accent" aria-hidden="true">
        <!-- Monitor icon -->
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
          <line x1="8" y1="21" x2="16" y2="21" />
          <line x1="12" y1="17" x2="12" y2="21" />
        </svg>
      </div>
      <h3>Windows</h3>
      <p class="req">Windows 10+ required</p>
      <p class="req">Coming soon</p>
    </article>

    <!-- Linux -->
    <article class="download-card" role="listitem">
      <div class="dl-icon-wrap accent" aria-hidden="true">
        <!-- Monitor icon -->
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
          <line x1="8" y1="21" x2="16" y2="21" />
          <line x1="12" y1="17" x2="12" y2="21" />
        </svg>
      </div>
      <h3>Linux</h3>
      <p class="req">Modern distributions supported</p>
      <p class="req">Coming soon</p>
    </article>
  </div>
</section>
