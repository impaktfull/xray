---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>xRay — See inside your Flutter app. Like never before.</title>
    <meta
      name="description"
      content="xRay gives you real-time visibility into network calls, logs, and storage across iOS, Android, and macOS. Debug faster, ship with confidence."
    />
    <meta
      name="keywords"
      content="Flutter, network inspector, debug, HTTP, logs, storage, iOS, Android, macOS, developer tools"
    />
    <meta name="author" content="impaktfull" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="assets/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="xRay — See inside your Flutter app. Like never before."
    />
    <meta
      property="og:description"
      content="Real-time visibility into network calls, logs, and storage for Flutter apps. Debug faster, ship with confidence."
    />
    <meta property="og:image" content="assets/open-graph/home.png?v1.0.0" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="xRay — Flutter Network Inspector" />
    <meta
      name="twitter:description"
      content="Real-time visibility into network calls, logs, and storage for Flutter apps."
    />
    <meta name="twitter:image" content="assets/open-graph/home.png?v1.0.0" />

    <!-- Canonical -->
    <link rel="canonical" href="https://xrayinspector.dev" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&family=Geologica:wght@400;500;600&family=Geist+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "xRay",
        "description": "Real-time network inspector and debugger for Flutter apps. Monitor HTTP calls, logs, and key-value storage across iOS, Android and macOS.",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "macOS, iOS, Android",
        "author": {
          "@type": "Organization",
          "name": "impaktfull"
        },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "description": "xRay is free for all users during the alpha testing period."
        }
      }
    </script>

    <!-- ===== Analytics + Consent ===== -->
    <!-- 1. Google Consent Mode v2 — all denied by default. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500
      });
      gtag('js', new Date());
      gtag('config', 'G-589QLTH004', { anonymize_ip: true });
    </script>

    <!-- 2. GA4 loader. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-589QLTH004"></script>

    <!-- 3. Cookiethough.dev banner. -->
    <script is:inline src="https://cookiethough.dev/lib/1.7.3" defer></script>

    <!-- 4. Local consent bridge + event tracking. -->
    <script is:inline src="scripts/consent.js?v=1.0.0" defer></script>
    <script is:inline src="scripts/analytics.js?v=1.0.0" defer></script>
  </head>

  <body>
    <slot />
  </body>
</html>
