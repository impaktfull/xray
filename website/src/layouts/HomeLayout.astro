---
import '../styles/global.css';
import { Font } from 'astro:assets';
import CookieBanner from '../components/site/CookieBanner.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>xRay — See inside your Flutter app. Like never before.</title>
    <meta
      name="description"
      content="xRay shows every network call, log and stored value of your Flutter app, live, on your desktop. For apps on iOS, Android, macOS, Windows and Linux."
    />
    <meta
      name="keywords"
      content="Flutter, network inspector, GraphQL, debug, HTTP, logs, storage, timeline, iOS, Android, macOS, Windows, Linux, developer tools"
    />
    <meta name="author" content="impaktfull" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="assets/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="xRay — See inside your Flutter app. Like never before."
    />
    <meta
      property="og:description"
      content="Every network call, log and stored value of your Flutter app, live on your desktop. Try the interactive demo."
    />
    <meta property="og:image" content="assets/open-graph/home.png?v1.0.0" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="xRay — Flutter Network Inspector" />
    <meta
      name="twitter:description"
      content="Every network call, log and stored value of your Flutter app, live on your desktop."
    />
    <meta name="twitter:image" content="assets/open-graph/home.png?v1.0.0" />

    <!-- Canonical -->
    <link rel="canonical" href="https://xrayinspector.dev" />

    <!-- Fonts: served from this site. The hero heading and body text are preloaded. -->
    <Font cssVariable="--font-ubuntu" preload={[{ weight: '700' }]} />
    <Font cssVariable="--font-geologica" preload={[{ weight: '400' }]} />
    <Font cssVariable="--font-geist-mono" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "xRay",
        "description": "Inspector for Flutter apps: network calls (including GraphQL), logs, key-value storage, files and a timeline, live on your desktop.",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "macOS, Windows, Linux",
        "author": {
          "@type": "Organization",
          "name": "impaktfull"
        },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "description": "xRay is free for all users during the alpha testing period."
        }
      }
    </script>

    <!-- Event tracking. Its events only reach Google once the visitor accepted analytics cookies. -->
    <script is:inline src="scripts/analytics.js?v=1.1.0" defer></script>
  </head>

  <body>
    <slot />
    <CookieBanner />
  </body>
</html>
